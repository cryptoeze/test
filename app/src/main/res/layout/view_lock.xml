<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="36dp">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_brand_mark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/locked_title"
        android:textColor="@color/text_primary"
        android:textSize="21sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/locked_body"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlock"
        android:layout_width="200dp"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/brand_teal"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/unlock"
        android:textAllCaps="false"
        android:textColor="@color/on_teal"
        android:textSize="15sp"
        app:cornerRadius="27dp"
        app:icon="@drawable/ic_fingerprint"
        app:iconGravity="textStart"
        app:iconTint="@color/on_teal" />
</LinearLayout>
