<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="36dp">

    <ImageView
        android:id="@+id/offlineArt"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_offline" />

    <TextView
        android:id="@+id/offlineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/offline_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/offlineBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/offline_body"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:backgroundTint="@color/brand_teal"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.02"
            android:text="@string/try_again"
            android:textAllCaps="false"
            android:textColor="@color/on_teal"
            android:textSize="15sp"
            app:cornerRadius="27dp" />

        <com.cryptoeze.app.ui.BrandSpinner
            android:id="@+id/retrySpinner"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
