<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.cryptoeze.app.web.AppWebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:overScrollMode="never" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:visibility="invisible"
            app:indicatorColor="@color/brand_teal"
            app:trackColor="@android:color/transparent"
            app:trackThickness="3dp"
            app:trackCornerRadius="3dp" />

        <include
            android:id="@+id/offline"
            layout="@layout/view_offline"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/lock"
        layout="@layout/view_lock"
        android:visibility="gone" />

    <com.cryptoeze.app.ui.IntroView
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/exitPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:alpha="0"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:textColor="@color/pill_text"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
